# Copy to .env; do not commit it. Startup commands below use Node --env-file=.env.
GATEWAY_MODE=replay
GATEWAY_PORT=8787
GATEWAY_REPLAY_FILE=.data/gateway-replay.json
# Live only: MongoDB Atlas or replica set URI. Never use NEXT_PUBLIC for secrets.
MONGODB_URI=
MONGODB_DB=exitnow
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=
GATEWAY_PUBLIC_URL=
GATEWAY_ADMIN_TOKEN=
# Planner requests must use a separate server/operator token.
PLANNER_API_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
# JSON secret-key byte array for a DEVNET-ONLY key. Never use a mainnet wallet.
SOLANA_SECRET_KEY=
# Alternatively, absolute backend-only path to the JSON keypair; never NEXT_PUBLIC.
SOLANA_KEYPAIR_PATH=
GATEWAY_OPERATOR_SECRET=
# Rider Rewards. All amounts are integer micro-USDC (1 USDC = 1,000,000).
# Funding defaults to zero. Positive allocation is checked against the official devnet USDC balance.
REWARDS_CAMPAIGN_UNITS=0
REWARDS_DAILY_UNITS=0
REWARDS_STATION_UNITS=0
REWARDS_CATEGORY_UNITS=0
REWARDS_GROUP_DAILY_UNITS=2000000
REWARDS_ACTIVE_DISCOVERIES=2
REWARDS_RESERVATION_MS=1800000
REWARDS_PAYOUT_THRESHOLD_UNITS=100000
# Separate developer-funded SOL budget; zero disables payouts.
REWARDS_FEE_BUDGET_LAMPORTS=0
REWARDS_MAX_PAYOUT_FEE_LAMPORTS=2100000
REWARDS_GROUP_ATA_LIMIT=1
# At least 32 random characters, server-only. Do not reuse the moderator token.
REWARDS_SESSION_SECRET=
REWARDS_MODERATOR_TOKEN=
# Exact canonical browser origin included in wallet signatures.
REWARDS_WEB_ORIGIN=http://localhost:3000
# Trusted known account/session links, e.g. {"photon:accountA":"group1","photon:accountB":"group1"}.
# Configure before opening tasks; changing linkage with existing credits needs a reviewed migration.
REWARDS_ACCOUNT_LINKS_JSON={}

# Public basemap provider. Keep required provider attribution visible.
# Default OSM service is best effort; no offline/bulk tile downloads.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=
