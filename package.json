{
  "name": "exitnow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "GATEWAY_MODE=replay next dev apps/web --hostname 127.0.0.1",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 127.0.0.1",
    "gateway": "node --env-file=.env --import tsx apps/gateway/src/server.ts",
    "test": "node --import tsx --test packages/*/test/*.test.ts apps/gateway/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gateway:replay": "GATEWAY_MODE=replay node --import tsx apps/gateway/src/server.ts",
    "verify:mongo": "node --env-file=.env --import tsx apps/gateway/src/verify-mongo.ts",
    "demo:rewards": "node --import tsx scripts/demo-rewards.ts"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@gsap/react": "^2.1.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "gsap": "^3.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "next": "^15.5.0",
    "protobufjs": "^7.6.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spectrum-ts": "latest",
    "three": "^0.186.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  }
}
